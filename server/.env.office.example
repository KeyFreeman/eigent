debug=false
url_prefix=/api

# Generate unique values with scripts/setup-office-sandbox.ps1.
POSTGRES_DB=eigent
POSTGRES_USER=eigent_app
POSTGRES_PASSWORD=replace-with-generated-postgres-password
REDIS_PASSWORD=replace-with-generated-redis-password
secret_key=replace-with-generated-jwt-secret
CHAT_SHARE_SECRET_KEY=replace-with-generated-share-secret
CHAT_SHARE_SALT=replace-with-generated-share-salt

# Keep the office UI local unless an administrator approves another origin.
CORS_ALLOW_ORIGINS=http://127.0.0.1:7777,http://localhost:7777
EIGENT_API_PORT=3002

# Database pool defaults for a small office deployment.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800

# Trigger Schedule Poller Configuration
ENABLE_TRIGGER_SCHEDULE_POLLER_TASK=true
TRIGGER_SCHEDULE_POLLER_INTERVAL=1
TRIGGER_SCHEDULE_POLLER_BATCH_SIZE=100
TRIGGER_SCHEDULE_MAX_DISPATCH_PER_TICK=0
ENABLE_EXECUTION_TIMEOUT_CHECKER=true
EXECUTION_TIMEOUT_CHECKER_INTERVAL=1
EXECUTION_PENDING_TIMEOUT_SECONDS=60
EXECUTION_RUNNING_TIMEOUT_SECONDS=600
